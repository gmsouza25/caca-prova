# ============================================================
#  .env.example — copie para .env e preencha (NÃO commite o .env)
#  O deploy-pages.sh lê estas variáveis e o build-config.mjs as
#  injeta nos campos [SECRET:...] do config.js. Deixe vazio para
#  usar o valor que já está no config.js (piloto).
# ============================================================

# ---- PIX (assinatura Premium R$ 19,90/ano) ----
PIX_CHAVE=03386809502                 # chave PIX (CPF, seu caso)
PIX_NOME_RECEBEDOR=                   # nome do titular (opcional)
PIX_VALOR=19.90
PIX_GATEWAY=demo                      # demo | mercadopago | gerencianet | asas | custom

# ---- Webhook de confirmação PIX (para cobrar de verdade) ----
# PIX_WEBHOOK_SECRET=               # segredo compartilhado
# PIX_STATUS_ENDPOINT=/api
# PIX_CRIAR_ENDPOINT=/api

# ---- Credenciais do gateway (só se PIX_GATEWAY != demo) ----
# MP_ACCESS_TOKEN=
# EFI_CLIENT_ID=
# EFI_CLIENT_SECRET=
# ASAAS_API_KEY=

# ---- E-mail / suporte ----
EMAIL_PUBLICO=suporte@cacaprova.com.br
EMAIL_DESTINO=gmsouza25@gmail.com     # destino OCULTO (nunca aparece no app)
FEEDBACK_ENDPOINT=/api/feedback

# ---- Push / notificações ----
PUSH_USE_FUNCTIONS=true               # usa as Pages Functions no mesmo domínio
# PUSH_PUBLIC_KEY=                    # chave pública VAPID (via /keys)
# PUSH_ENDPOINT=

# ---- Worker de push (se usar Worker externo em vez das Pages Functions) ----
# VAPID_PUBLIC_KEY=                  # do worker/generate-vapid.mjs
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:suporte@cacaprova.com.br

# ---- Mercado Pago (definir quando for cobrar de verdade) ----
# Como criar: painel do Mercado Pago > Suas integrações > App > "Produção"
#   a) MP_ACCESS_TOKEN: Access Token da aplicação (Credenciais > Produção)
#   b) PIX_WEBHOOK_URL: URL de notificação do MP = https://cacaprova.com.br/api/pix-webhook
#   c) PIX_WEBHOOK_SECRET: segredo p/ assinatura (PIX_WEBHOOK_SIG=mp)
#      -> gerar na integração (Webhooks > Chave de assinatura)
#   d) PIX_CLIENT_EMAIL (opcional): e-mail do comprador p/ identificação
# MP_ACCESS_TOKEN=
# PIX_WEBHOOK_URL=https://cacaprova.com.br/api/pix-webhook
# PIX_WEBHOOK_SIG=mp
# PIX_CLIENT_EMAIL=

# ---- IA / enriquecimento de editais (scripts/llm-enrich.mjs) — OPCIONAL ----
# Chave gratuita do Google Gemini: https://aistudio.google.com/apikey
# Para rodar:  npm install   (instala pdf-parse)  +  node scripts/llm-enrich.mjs
LLM_API_KEY=                     # deixe VAZIA para desativar (não quebra o crawl)
# Chaves novas do Google (formato "AQ.Ab...") funcionam APENAS na rota nativa (padrão).
# Chaves clássicas "AIza..." também funcionam na rota nativa; se preferir a rota
# OpenAI-compatível com chave AIza, descomente:  LLM_BASE_URL=.../v1beta/openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-3.6-flash       # modelo atual; confirme disponibilidade em aistudio.google.com
# LLM_ESTIMATE=1                # '1' = se o edital estiver bloqueado, estimar e marcar "≈" (política B)
# LLM_CACHE_DAYS=14             # dias para limpar o cache de editais (crawler/edital_cache/)
